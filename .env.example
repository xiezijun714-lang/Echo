# Copy this file to .env. The real .env is ignored by git.
VENV_PATH=${VENV_PATH:-/path/to/venv_echo_megatron}
# Use Qwen3-30B-A3B (model_type=qwen3_moe) for 30B launchers, or Qwen3-32B
# (model_type=qwen3) for 32B launchers.
MODEL_PATH=${MODEL_PATH:-/path/to/Qwen3-30B-A3B-Instruct-2507}
RETRIEVER_MODEL_PATH=${RETRIEVER_MODEL_PATH:-/path/to/Qwen3-Embedding-8B}
DATA_DIR=${DATA_DIR:-/path/to/browsecomp-plus-processed}

# The corpus can replace a prebuilt dense cache.
RETRIEVER_DENSE_CACHE=${RETRIEVER_DENSE_CACHE:-/path/to/browsecomp_dense_cache.pkl}
# RETRIEVER_CORPUS_FILE=/path/to/corpus.parquet

TRAINER_IPS=${TRAINER_IPS:-10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4}

BCP_JUDGE_API_BASE=${BCP_JUDGE_API_BASE:-https://your-openai-compatible-endpoint/v1}
BCP_JUDGE_MODEL=${BCP_JUDGE_MODEL:-your-judge-model}
BCP_JUDGE_API_KEY_ENV=${BCP_JUDGE_API_KEY_ENV:-OPENAI_API_KEY}
# Export OPENAI_API_KEY in the process environment; do not store it here.

# Use offline logging unless online W&B is explicitly configured.
WANDB_MODE=${WANDB_MODE:-offline}
