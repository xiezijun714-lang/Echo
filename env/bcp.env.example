# Copy this file to env/bcp.env and replace the paths for the local Blackwell machine.
# The real .env is ignored by git.
VENV_PATH=${VENV_PATH:-/path/to/venv_echo_blackwell}
MODEL_PATH=${MODEL_PATH:-/path/to/model/Qwen3-32B}
RETRIEVER_MODEL_PATH=${RETRIEVER_MODEL_PATH:-/path/to/model/Qwen3-Embedding-8B}
DATA_DIR=${DATA_DIR:-/path/to/Echo/dataset/bcp}
RETRIEVER_DENSE_CACHE=${RETRIEVER_DENSE_CACHE:-/path/to/browsecomp_dense_cache_tevatron.pkl}

# One-node launch. Set the machine IP when the launcher cannot infer it.
TRAINER_IPS=${TRAINER_IPS:-127.0.0.1}

# The judge endpoint is only needed when reward scoring calls an API.
BCP_JUDGE_API_BASE=${BCP_JUDGE_API_BASE:-https://your-openai-compatible-endpoint/v1}
BCP_JUDGE_MODEL=${BCP_JUDGE_MODEL:-your-judge-model}
BCP_JUDGE_API_KEY_ENV=${BCP_JUDGE_API_KEY_ENV:-OPENAI_API_KEY}
# Export OPENAI_API_KEY in the process environment; do not store it here.

WANDB_MODE=${WANDB_MODE:-offline}
